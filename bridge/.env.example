# Copy to bridge/.env and fill in. bridge/.env is gitignored: never commit it.

# Supabase session pooler string (port 5432). Ask the project owner; it contains the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Station name used when a sensor node doesn't send one (the old firmware doesn't).
STATION_NAME=FS_LAKE_STATION_01
# Comma-separated list of station names the bridge accepts. Defaults to STATION_NAME.
ALLOWED_STATIONS=FS_LAKE_STATION_01

# Require nodes to send this token (header X-Ingest-Token or ?token=). Empty = not required locally.
# On Vercel it is REQUIRED: without it the bridge refuses all readings.
INGEST_TOKEN=

PORT=5000

# Organization and site the station belongs to (created once if missing).
LAKE_ORG_NAME=Aarogya Jal
LAKE_ORG_SLUG=aarogya-jal
LAKE_SITE_NAME=Fateh Sagar Lake

# Only for import_mysql_to_supabase.py (the old WampServer MySQL defaults).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=aarogya_jal_db
