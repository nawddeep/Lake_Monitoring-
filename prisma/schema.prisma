// Lake monitoring platform: database schema (draft for review)
// PostgreSQL 18, Prisma 7.10.0. All times are stored in UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Choices ----------

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum StationKind {
  PHYSICAL
  SIMULATED // digital twin: kept apart so test data never mixes with real data
}

enum ReadingFlag {
  OK
  SUSPECT
  BAD
}

enum SampleSource {
  LAB
  FIELD_KIT
}

enum ResultQualifier {
  EQUAL
  LESS_THAN // for lab results reported as "<1"
  GREATER_THAN
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ---------- People ----------

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  users User[]
  sites Site[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  name           String
  email          String   @unique
  passwordHash   String?
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  calibrations Calibration[]
  samples      Sample[]
  alertsActed  Alert[]

  @@index([organisationId])
}

// ---------- Places and hardware ----------

model Site {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  name           String // e.g. "Fateh Sagar Lake"
  description    String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id])
  stations     Station[]
  samples      Sample[]

  @@unique([organisationId, name])
}

model Station {
  id          String      @id @default(uuid()) @db.Uuid
  siteId      String      @db.Uuid
  name        String
  kind        StationKind @default(PHYSICAL)
  latitude    Decimal?    @db.Decimal(9, 6)
  longitude   Decimal?    @db.Decimal(9, 6)
  installedAt DateTime?   @db.Timestamptz(6)
  retiredAt   DateTime?   @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  site          Site                 @relation(fields: [siteId], references: [id])
  installations SensorInstallation[]
  readings      Reading[]
  alerts        Alert[]
  samples       Sample[]

  @@unique([siteId, name])
}

model Sensor {
  id           String  @id @default(uuid()) @db.Uuid
  serialNumber String  @unique
  manufacturer String?
  model        String?
  notes        String?

  installations SensorInstallation[]
  readings      Reading[]
  calibrations  Calibration[]
}

// Which probe sat on which station, and when. Probes get swapped;
// this keeps old readings credited to the right probe.
model SensorInstallation {
  id          String    @id @default(uuid()) @db.Uuid
  sensorId    String    @db.Uuid
  stationId   String    @db.Uuid
  depthM      Decimal?  @db.Decimal(6, 2)
  installedAt DateTime  @db.Timestamptz(6)
  removedAt   DateTime? @db.Timestamptz(6)

  sensor  Sensor  @relation(fields: [sensorId], references: [id])
  station Station @relation(fields: [stationId], references: [id])

  @@index([stationId, installedAt])
  @@index([sensorId, installedAt])
}

// ---------- What gets measured ----------

model Parameter {
  id   Int    @id @default(autoincrement())
  code String @unique // e.g. "do_mgl", "ph", "turbidity_ntu"
  name String // e.g. "Dissolved oxygen"
  unit String // the one unit values are stored in, e.g. "mg/L"

  limits        Limit[]
  readings      Reading[]
  sampleResults SampleResult[]
  calibrations  Calibration[]
  alerts        Alert[]
}

// A water quality standard, e.g. "CPCB Class C" or "BIS 10500 acceptable".
model Standard {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  source String?

  limits Limit[]
}

model Limit {
  id          Int    @id @default(autoincrement())
  standardId  Int
  parameterId Int
  minValue    Float?
  maxValue    Float?

  standard  Standard  @relation(fields: [standardId], references: [id])
  parameter Parameter @relation(fields: [parameterId], references: [id])

  @@unique([standardId, parameterId])
}

// ---------- Sensor data ----------

// One value from one probe at one time. Raw values are never overwritten;
// bad values are flagged instead.
model Reading {
  id          BigInt      @id @default(autoincrement())
  stationId   String      @db.Uuid
  sensorId    String      @db.Uuid
  parameterId Int
  measuredAt  DateTime    @db.Timestamptz(6)
  value       Float
  flag        ReadingFlag @default(OK)
  receivedAt  DateTime    @default(now()) @db.Timestamptz(6)

  station   Station   @relation(fields: [stationId], references: [id])
  sensor    Sensor    @relation(fields: [sensorId], references: [id])
  parameter Parameter @relation(fields: [parameterId], references: [id])
  alerts    Alert[]

  // The same reading sent twice after a signal gap is stored once.
  @@unique([sensorId, parameterId, measuredAt])
  @@index([stationId, parameterId, measuredAt])
}

// Side-by-side checks against the handheld meter, and the correction applied.
model Calibration {
  id             String   @id @default(uuid()) @db.Uuid
  sensorId       String   @db.Uuid
  parameterId    Int
  performedAt    DateTime @db.Timestamptz(6)
  performedById  String?  @db.Uuid
  referenceValue Float? // what the handheld meter read
  sensorBefore   Float? // what the probe read before cleaning
  sensorAfter    Float? // what the probe read after cleaning
  offset         Float? // correction to add from this time on
  slope          Float?
  notes          String?

  sensor      Sensor    @relation(fields: [sensorId], references: [id])
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([sensorId, parameterId, performedAt])
}

// ---------- Lab and field-kit tests ----------

model Sample {
  id            String       @id @default(uuid()) @db.Uuid
  siteId        String       @db.Uuid
  stationId     String?      @db.Uuid
  source        SampleSource
  collectedAt   DateTime     @db.Timestamptz(6)
  depthM        Decimal?     @db.Decimal(6, 2)
  labName       String?
  collectedById String?      @db.Uuid
  notes         String?

  site        Site           @relation(fields: [siteId], references: [id])
  station     Station?       @relation(fields: [stationId], references: [id])
  collectedBy User?          @relation(fields: [collectedById], references: [id])
  results     SampleResult[]

  @@index([siteId, collectedAt])
}

model SampleResult {
  id          String          @id @default(uuid()) @db.Uuid
  sampleId    String          @db.Uuid
  parameterId Int
  value       Float?
  qualifier   ResultQualifier @default(EQUAL)
  method      String? // e.g. "BOD 3-day at 27 C"

  sample    Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter Parameter @relation(fields: [parameterId], references: [id])

  @@unique([sampleId, parameterId])
}

// ---------- Alerts ----------

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  stationId        String        @db.Uuid
  parameterId      Int?
  readingId        BigInt?
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  message          String
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?     @db.Timestamptz(6)
  acknowledgedById String?       @db.Uuid

  station        Station    @relation(fields: [stationId], references: [id])
  parameter      Parameter? @relation(fields: [parameterId], references: [id])
  reading        Reading?   @relation(fields: [readingId], references: [id])
  acknowledgedBy User?      @relation(fields: [acknowledgedById], references: [id])

  @@index([stationId, status, createdAt])
}
