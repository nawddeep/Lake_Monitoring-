# Local PostgreSQL from docker-compose.yml (service "db"). Change the password for anything beyond local use.
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://lake:change_me@localhost:5432/lake_monitoring"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

RESEND_API_KEY=
EMAIL_FROM=
# Set false to skip admin and organization invitation emails and share links manually.
# Defaults to true when unset; a missing RESEND_API_KEY also skips sending.
INVITATION_EMAIL_ENABLED=false

# Inngest Cloud credentials (not required for local development).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=1 on local to use the local Dev Server.
INNGEST_DEV=1
