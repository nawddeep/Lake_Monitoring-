# Lake Monitoring Web: every setting the project uses.
#
# With Docker (`docker compose up`) this file is OPTIONAL: the defaults below are built in and the
# containers always use the local PostgreSQL. Copy it to `.env` (cp .env.example .env) to change
# a value, or to run the app outside Docker with `npm run dev`.
# `.env` is gitignored. Never commit real passwords or keys.

# ---- Database (default: local PostgreSQL from docker-compose.yml, service "db") ----
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://lake:change_me@localhost:5432/lake_monitoring"
# Optional. Prisma migrations use DIRECT_URL when set, otherwise DATABASE_URL.
# DIRECT_URL="postgresql://lake:change_me@localhost:5432/lake_monitoring"

# To use the shared Supabase database instead (outside Docker only), replace the two lines above
# with the session pooler string you were sent privately, in both variables:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Login (Better Auth) ----
# Any long random string locally. Generate one with: openssl rand -base64 32
# Leave empty with Docker to use the built-in local-only default.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---- Email (optional) ----
RESEND_API_KEY=
EMAIL_FROM=
# false: invitations are created as links you share yourself, no email is sent.
INVITATION_EMAIL_ENABLED=false

# ---- Background jobs (Inngest, optional) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 1 = use the local Inngest Dev Server
INNGEST_DEV=1

# ---- Sensor bridge (docker compose --profile bridge up) ----
STATION_NAME=FS_LAKE_STATION_01
ALLOWED_STATIONS=FS_LAKE_STATION_01
# Empty = boards don't need a token locally. Required on Vercel.
INGEST_TOKEN=
# Host port for the bridge. macOS uses 5000 for AirPlay: use 5001 there.
BRIDGE_PORT=5000
